{
  "model_release": "genis-next-stage-v1",
  "model_type": "transition_focused_hist_gradient_boosting",
  "evidence_status": "real_public_dataset",
  "data_release": "genis-temporal-v1",
  "features": [
    "flow_count",
    "packet_count",
    "byte_count",
    "unique_src_ips",
    "unique_dst_ips",
    "unique_dst_ports",
    "new_dst_hosts",
    "new_dst_ports",
    "tcp_flow_count",
    "syn_count",
    "ack_count",
    "rst_count",
    "fin_count",
    "psh_count",
    "urg_count",
    "syn_only_count",
    "syn_ack_ratio",
    "rst_ratio",
    "max_host_fanout",
    "max_port_fanout",
    "port_entropy",
    "sequential_port_score",
    "east_west_flows",
    "north_south_flows",
    "iat_mean_ms",
    "iat_std_ms",
    "iat_cv",
    "flow_duration_mean_ms",
    "flow_duration_p95_ms"
  ],
  "history_steps": 6,
  "window_seconds": 10,
  "target_definition": "earliest observed future stage different from current stage; otherwise current stage",
  "transition_sample_weight": 3.0,
  "alert_authority": false,
  "seed": 42
}
